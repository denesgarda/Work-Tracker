{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work-tracker",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  // Access protects the custom domain only. Leaving the workers.dev route on
  // would serve this same app from a hostname Access never sees.
  "workers_dev": false,

  "assets": { "directory": "./public", "binding": "ASSETS" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "work-tracker",
      "database_id": "8b99352d-c6c4-4dc2-bb1d-e99c791eb226",
      "migrations_dir": "migrations"
    }
  ],

  // Receipts and statements. Private: files are only ever served through the
  // Worker, behind Access — there is no public bucket URL.
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "work-tracker-files" }
  ],

  "durable_objects": {
    "bindings": [{ "name": "SYNC", "class_name": "SyncHub" }]
  },

  // SQLite-backed classes are the only kind available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncHub"] }],

  "vars": {
    // Set to your Access team domain + application AUD to enforce auth.
    // Left blank locally so `wrangler dev` works without Zero Trust.
    "ACCESS_TEAM_DOMAIN": "denesgarda.cloudflareaccess.com",
    "ACCESS_AUD": "09b7403f2b42ab06d50cd159168d0a2da90830ad8abdb2bcdfbcf37c5829e56c"
  }
}
